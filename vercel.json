{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"backend": {
			"root": "backend",
			"framework": "express"
		},
		"tuottajamarket": {
			"root": "tuottajamarket",
			"framework": "vite"
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "backend"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "tuottajamarket"
			}
		}
	]
}
